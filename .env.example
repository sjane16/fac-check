# Copy this file to .env and fill in the values. Never commit .env.

SECRET_KEY=
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
GEMINI_API_KEY=
# Gmail App Password for facchecknoreply@gmail.com
EMAIL_HOST_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Local development / testing ---
# DEBUG is off unless set here. Without DEBUG=True, runserver does not serve CSS/JS
# unless you first run `python manage.py tailwind build` and `python manage.py collectstatic`.
DEBUG=True

# Optional. Comma-separated; defaults to 127.0.0.1,localhost,192.168.100.58,192.168.100.59
# ALLOWED_HOSTS=127.0.0.1,localhost

# Only needed when testing with DEBUG=False over plain http (no HTTPS),
# otherwise login cookies are never sent and sign-in silently fails.
# SECURE_COOKIES=False

# --- Live server ---
# DEBUG=False
# ALLOWED_HOSTS=faccheck.example.com
# CSRF_TRUSTED_ORIGINS=https://faccheck.example.com
# SITE_URL=https://faccheck.example.com
